# Local development reads these when exported by your shell. Compose reads .env automatically.
PORT=4317
DATA_DIR=./data
MAX_ROOMS=50
# Coolify: set the actual public HTTPS origin, for example https://race.example.com
PUBLIC_URL=
# 0 for direct local connections; 1 only for one trusted reverse proxy (Coolify Traefik).
TRUST_PROXY_HOPS=0
# Compose only: change HOST_BIND to 0.0.0.0 to allow phones on your LAN.
HOST_BIND=127.0.0.1
GAME_PORT=4320
