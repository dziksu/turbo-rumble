{
  "name": "turbo-rumble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js && esbuild scripts/backup.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/backup.js",
    "start": "node dist-server/index.js --production",
    "smoke": "node --import tsx scripts/smoke.ts",
    "playtest": "node --import tsx scripts/playtest-network.ts",
    "lint": "eslint client server shared scripts tests vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "backup": "node dist-server/backup.js",
    "release": "node --import tsx scripts/release.ts",
    "release:preview": "node --import tsx scripts/release.ts --dry-run",
    "release:prepare": "prettier --write CHANGELOG.md && npm run build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "@fontsource/bungee": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.180.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.25.10",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.7"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dziksu/turbo-rumble.git"
  }
}
